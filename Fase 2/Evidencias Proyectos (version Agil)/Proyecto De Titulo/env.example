# Variables de entorno del Sistema Unidad Territorial
# Este archivo es una plantilla: muestra qué variables usa el sistema y sus valores de ejemplo.
# Config.php lee estas variables; si no existen (por ejemplo en XAMPP), usa localhost, root, sin clave y unidad_territorial.
# Los mismos valores están en docker-compose.yml, así que para levantar con Docker no hay que crear nada extra.

# Conexión de la aplicación web con la base de datos
DB_HOST=db
DB_USER=junta
DB_PASS=junta_2026
DB_NAME=unidad_territorial

# Contenedor de MariaDB
MARIADB_ROOT_PASSWORD=root_junta_2026
MARIADB_DATABASE=unidad_territorial
MARIADB_USER=junta
MARIADB_PASSWORD=junta_2026
TZ=America/Santiago
